# Strategy Factory — Environment Variables Template (ETF-Only)
# Copy this file to ".env" for local use, or set the same names in Railway.

# ── Dashboard authentication ──
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# ── Alpaca PAPER trading ──
ALPACA_API_KEY=your-paper-api-key
ALPACA_API_SECRET=your-paper-api-secret

# ── Telegram notifications ──
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ── Persistent paths (Docker/Railway already sets these) ──
STRATEGY_FACTORY_DATA_DIR=data
STRATEGY_FACTORY_REPORT_DIR=reports

# ── Trading desk cycle interval (minutes) ──
DESK_CYCLE_INTERVAL_MIN=15

# ── Alpaca auto-trading interval (minutes) ──
ALPACA_AUTO_TRADE_INTERVAL_MIN=60

# ── Daily analysis scheduler (UTC hour) ──
DAILY_REPORT_HOUR_UTC=12

# ── Intraday signal/risk tuning ──
INTRADAY_GATE_ENABLED=true
INTRADAY_MIN_SIGNAL_CONFIDENCE=0.56
INTRADAY_EXTREME_ATR_PCT=8.0
INTRADAY_MIN_VOLUME_RATIO=0.35
INTRADAY_BASE_STOP_LOSS_PCT=2.2
INTRADAY_BASE_TAKE_PROFIT_PCT=4.2
INTRADAY_BASE_TRAILING_STOP_PCT=1.6
INTRADAY_MAX_HOLD_HOURS=18

# ── Conservative mode thresholds ──
# CONSERVATIVE_DAILY_PROFIT_THRESHOLD_PCT=1.00
# CONSERVATIVE_DAILY_LOSS_THRESHOLD_PCT=0.50
# CONSERVATIVE_RISK_PER_TRADE_PCT=0.15
# CONSERVATIVE_MAX_OPEN_RISK_PCT=0.50
# CONSERVATIVE_MAX_OPEN_POSITIONS=5
